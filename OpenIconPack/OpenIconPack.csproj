<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net472</TargetFrameworks>
	  
	  
    <Nullable Condition="'$(TargetFramework)' == 'net8.0'">enable</Nullable>
    <Nullable Condition="'$(TargetFramework)' == 'net472'">disable</Nullable>


	  <ImplicitUsings Condition="'$(TargetFramework)' == 'net8.0'">enable</ImplicitUsings>
	  <ImplicitUsings Condition="'$(TargetFramework)' == 'net472'">disable</ImplicitUsings>
	  
    <PackageId>OpenIconPack</PackageId>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Title>Open Icon Pack</Title>
    <Version>1.0.2</Version>
    <Authors>Mustafa Duran</Authors>
    <Company>Mustafa Duran</Company>
    <Product>Open Icon Pack</Product>
    <Description>Open Icon Pack - WinForm and AspNet</Description>
    <Copyright>Copyright 2026</Copyright>
    <RepositoryType>git</RepositoryType>
    <PackageTags>OpenIconPack IconPack FreeIconPack Icon OpenIcon</PackageTags>
    <RepositoryUrl>https://github.com/mustafaduran/OpenIconPack</RepositoryUrl>
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="json\OpenIconPack_Default.json" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="json\OpenIconPack_Default.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\icon.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Svg" Version="3.4.8" />
  </ItemGroup>
	
    <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
		<PackageReference Include="System.Text.Json" Version="8.0.5" />
	</ItemGroup>

</Project>
