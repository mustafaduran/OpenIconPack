<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageId>OpenIconPack</PackageId>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Title>Open Icon Pack</Title>
    <Version>1.0.0</Version>
    <Authors>Mustafa Duran</Authors>
    <Company>Mustafa Duran</Company>
    <Product>Open Icon Pack</Product>
    <Description>Open Icon Pack - WinForm and AspNet</Description>
    <Copyright>Copyright 2026</Copyright>
    <RepositoryType>git</RepositoryType>
    <PackageTags>OpenIconPack IconPack FreeIconPack Icon OpenIcon</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="json\OpenIconPack_Default.json" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="json\OpenIconPack_Default.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Svg" Version="3.4.8" />
  </ItemGroup>

</Project>
